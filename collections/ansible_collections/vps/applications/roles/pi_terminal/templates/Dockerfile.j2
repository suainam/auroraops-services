ARG TTYD_IMAGE={{ pi_terminal_ttyd_image }}
ARG BUN_IMAGE={{ pi_terminal_bun_image }}
FROM ${TTYD_IMAGE} AS ttyd
FROM ${BUN_IMAGE}

ARG DEBIAN_MIRROR={{ pi_terminal_debian_mirror }}
ARG DEBIAN_SECURITY_MIRROR={{ pi_terminal_debian_security_mirror }}
ARG DEBIAN_SUITE={{ pi_terminal_debian_suite }}
ARG DEBIAN_SECURITY_SUITE={{ pi_terminal_debian_security_suite }}
ARG OMP_VERSION={{ pi_terminal_omp_version }}
ARG PI_UID={{ pi_terminal_container_uid }}
ARG PI_GID={{ pi_terminal_container_gid }}

USER root

RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      "deb ${DEBIAN_MIRROR} ${DEBIAN_SUITE} main" \
      "deb ${DEBIAN_MIRROR} ${DEBIAN_SUITE}-updates main" \
      "deb ${DEBIAN_SECURITY_MIRROR} ${DEBIAN_SECURITY_SUITE} main" \
      > /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      curl \
      git \
      openssh-client \
      tmux \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ttyd /usr/bin/ttyd /usr/bin/ttyd

RUN mkdir -p /opt/omp-home \
    && HOME=/opt/omp-home bun install -g \
      "@oh-my-pi/pi-coding-agent@${OMP_VERSION}" \
    && omp --version

RUN groupadd --gid "${PI_GID}" pi \
    && useradd --uid "${PI_UID}" --gid "${PI_GID}" --create-home --shell /bin/bash pi \
    && mkdir -p /home/pi/.omp/agent /home/pi/.cache /workspace /etc/omp \
    && chown -R "${PI_UID}:${PI_GID}" /home/pi /workspace

COPY omp-config.yml /etc/omp/config.yml
COPY --chown=${PI_UID}:${PI_GID} start-pi.sh /usr/local/bin/start-pi
COPY --chown=${PI_UID}:${PI_GID} start-server.sh /usr/local/bin/start-server
COPY --chown=${PI_UID}:${PI_GID} tmux.conf /home/pi/.tmux.conf

RUN chmod 0755 /usr/bin/ttyd /usr/local/bin/start-pi /usr/local/bin/start-server \
    && chmod 0444 /etc/omp/config.yml \
    && chmod 0644 /home/pi/.tmux.conf

ENV HOME=/home/pi \
    TERM=xterm-256color \
    XDG_CACHE_HOME=/home/pi/.cache \
    BUN_INSTALL_CACHE_DIR=/home/pi/.cache/bun \
    PI_CODING_AGENT_DIR=/home/pi/.omp/agent \
    PI_SKIP_VERSION_CHECK=1 \
    PI_TELEMETRY=0 \
    PI_NO_TITLE=1 \
    PI_NOTIFICATIONS=off \
    PI_FORCE_IMAGE_PROTOCOL=none

USER pi
WORKDIR /workspace
EXPOSE 7681
ENTRYPOINT ["/usr/local/bin/start-server"]
