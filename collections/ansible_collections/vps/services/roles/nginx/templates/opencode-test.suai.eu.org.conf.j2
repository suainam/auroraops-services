# HTTP -> HTTPS 重定向
server {
    listen 80;
    server_name opencode-test.suai.eu.org;
    return 301 https://$host$request_uri;
}

# HTTPS 主配置
server {
    listen 443 ssl;
    http2 on;
    server_name opencode-test.suai.eu.org;

    # SSL 证书（使用 suai.eu.org 通配符证书）
    ssl_certificate       /etc/letsencrypt/live/suai.eu.org/fullchain.pem;
    ssl_certificate_key   /etc/letsencrypt/live/suai.eu.org/privkey.pem;

    # 引入通用配置
    include /etc/nginx/conf.d/common_ssl.conf;
    include /etc/nginx/conf.d/common_headers.conf;
    include /etc/nginx/conf.d/common_performance.conf;

    # Cloudflare IP 白名单（复用现有安全策略）
    include /etc/nginx/conf.d/cfip.conf;
    deny all;

    # OpenCode Server 反向代理
    location / {
        proxy_pass http://127.0.0.1:{{ opencode_server_port | default(4096) }};
        
        # WebSocket 支持（OpenCode TUI 需要）
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        
        # SSE 支持（事件流）
        proxy_set_header X-Accel-Buffering no;
        proxy_buffering off;
        proxy_cache off;
        
        # 标准代理头
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket 自动认证注入（解决浏览器不支持 WS URL 密码的问题）
{% if opencode_server_password is defined and opencode_server_password | length > 0 %}
        proxy_set_header Authorization $opencode_ws_auth;
{% endif %}
        
        # 超时设置（AI 响应可能较长）
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
        proxy_send_timeout 300s;
        
        # 大文件上传支持
        client_max_body_size 100M;
    }

    # API 文档路径
    location /doc {
        proxy_pass http://127.0.0.1:{{ opencode_server_port | default(4096) }}/doc;
        include /etc/nginx/conf.d/common_proxy.conf;
    }

    # 健康检查
    location /global/health {
        proxy_pass http://127.0.0.1:{{ opencode_server_port | default(4096) }}/global/health;
        include /etc/nginx/conf.d/common_proxy.conf;
    }
}
