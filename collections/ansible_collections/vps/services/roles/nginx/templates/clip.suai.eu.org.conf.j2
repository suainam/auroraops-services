server {
    listen 80;
    listen [::]:80;
    server_name clip.suai.eu.org;
    return 301 https://$host$request_uri;
}

server {
    listen {{ nginx_https_port | default(443) }} ssl;
    listen [::]:{{ nginx_https_port | default(443) }} ssl;
    http2 on;
    server_name clip.suai.eu.org;

    ssl_certificate /etc/letsencrypt/live/suai.eu.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/suai.eu.org/privkey.pem;

    include /etc/nginx/conf.d/common_ssl.conf;
    include /etc/nginx/conf.d/common_headers.conf;
    include /etc/nginx/conf.d/common_performance.conf;

    client_max_body_size 128M;

    location / {
        proxy_pass http://127.0.0.1:{{ app_port_cliproxyapi | default(30011) }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
}
