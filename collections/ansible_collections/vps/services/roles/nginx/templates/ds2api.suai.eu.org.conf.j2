{% set ssl_cert_name = site_config.ssl_cert_name | default('suai.eu.org', true) %}
server {
    listen 80;
    listen [::]:80;
    server_name ds2api.suai.eu.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ds2api.suai.eu.org;

    ssl_certificate /etc/letsencrypt/live/{{ ssl_cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ ssl_cert_name }}/privkey.pem;

    include /etc/nginx/conf.d/common_ssl.conf;
    include /etc/nginx/conf.d/common_headers.conf;
    include /etc/nginx/conf.d/common_performance.conf;
    include /etc/nginx/conf.d/cfip.conf;
    deny all;

    location / {
        proxy_pass http://127.0.0.1:{{ app_port_ds2api }};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header X-Accel-Buffering no;
        chunked_transfer_encoding on;
        tcp_nodelay on;
    }
}
