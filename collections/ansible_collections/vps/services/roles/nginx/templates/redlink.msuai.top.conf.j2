server {
    listen 80;
    server_name redlink.msuai.top;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name redlink.msuai.top;

    ssl_certificate       /etc/letsencrypt/live/msuai.top/fullchain.pem;
    ssl_certificate_key   /etc/letsencrypt/live/msuai.top/privkey.pem;

    include /etc/nginx/conf.d/common_ssl.conf;
    include /etc/nginx/conf.d/common_headers.conf;
    include /etc/nginx/conf.d/common_performance.conf;

    include /etc/nginx/conf.d/cfip.conf;
    deny all;

    location / {
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/conf.d/common_proxy.conf;
        proxy_set_header HOST $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    
    location /static/ {
        alias /opt/redlink/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    
    location /media/ {
        alias /opt/redlink/media/;
         expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
