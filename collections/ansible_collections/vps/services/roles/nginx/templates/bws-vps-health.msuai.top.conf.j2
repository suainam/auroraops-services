{% set ssl_cert_name = site_config.ssl_cert_name | default('suai.eu.org', true) %}

server {
    listen 80;
    server_name bws-vps-health.msuai.top;
    return 301 https://$host$request_uri;
}

server {
    listen {{ nginx_https_port | default(443) }} ssl;
    listen [::]:{{ nginx_https_port | default(443) }} ssl;
    http2 on;
    server_name bws-vps-health.msuai.top;

    ssl_certificate /etc/letsencrypt/live/{{ ssl_cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ ssl_cert_name }}/privkey.pem;

    include /etc/nginx/conf.d/common_ssl.conf;
    include /etc/nginx/conf.d/common_headers.conf;
    include /etc/nginx/conf.d/common_performance.conf;

    include /etc/nginx/conf.d/cfip.conf;
    deny all;

    location = /alive {
        default_type text/plain;
        return 200 "alive\n";
    }

    location / {
        return 404;
    }
}
