server {
    listen 80;
    listen [::]:80;
    server_name bws.suai.eu.org;
    return 301 https://$host$request_uri;
}

server {
    listen {{ nginx_https_port | default(443) }} ssl;
    listen [::]:{{ nginx_https_port | default(443) }} ssl;
    http2 on;
    server_name bws.suai.eu.org;

    ssl_certificate /etc/letsencrypt/live/suai.eu.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/suai.eu.org/privkey.pem;

    include /etc/nginx/conf.d/common_ssl.conf;
    include /etc/nginx/conf.d/common_headers.conf;
    include /etc/nginx/conf.d/common_performance.conf;

    client_max_body_size 128M;

    location ~* -connector\.html$ {
        proxy_pass http://127.0.0.1:{{ app_port_vaultwarden_http | default(30007) }};
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        add_header X-Frame-Options "" always;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ app_port_vaultwarden_http | default(30007) }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /notifications/hub {
        proxy_pass http://127.0.0.1:{{ app_port_vaultwarden_http | default(30007) }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /notifications/hub/negotiate {
        proxy_pass http://127.0.0.1:{{ app_port_vaultwarden_http | default(30007) }};
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline'" always;
    }
}
