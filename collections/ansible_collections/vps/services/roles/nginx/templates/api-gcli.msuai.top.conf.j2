server {
    listen 80;
    server_name api-gcli.msuai.top;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name api-gcli.msuai.top;

    ssl_certificate       /etc/letsencrypt/live/msuai.top/fullchain.pem;
    ssl_certificate_key   /etc/letsencrypt/live/msuai.top/privkey.pem;

    include /etc/nginx/conf.d/common_ssl.conf;
    include /etc/nginx/conf.d/common_headers.conf;
    include /etc/nginx/conf.d/common_performance.conf;

    include /etc/nginx/conf.d/cfip.conf;
    deny all;

    # 兼容 Antigravity 客户端上传路径 (强制 mode=antigravity)
    location /antigravity/upload {
        client_max_body_size 100m;
        rewrite ^/antigravity/upload(.*)$ /creds/upload$1?mode=antigravity break;
        proxy_pass http://127.0.0.1:{{ app_port_gcli2api_api | default(30071) }};
        
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 兼容 Antigravity 客户端凭证状态查询 (强制 mode=antigravity 避免数据混淆)
    location /antigravity/creds/ {
        rewrite ^/antigravity/creds/(.*)$ /creds/$1?mode=antigravity break;
        proxy_pass http://127.0.0.1:{{ app_port_gcli2api_api | default(30071) }};
        
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 兼容日志流路径 (去除 /auth 前缀，注入认证token)
    location /auth/logs/stream {
        rewrite ^/auth/logs/stream(.*)$ /logs/stream$1?token={{ gcli2api_password | default('cn@h!w%8V5si*3D2') | urlencode }} break;
        proxy_pass http://127.0.0.1:{{ app_port_gcli2api_api | default(30071) }};

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ app_port_gcli2api_api | default(30071) }};

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header X-Accel-Buffering no;

        # include /etc/nginx/conf.d/common_proxy.conf;
    }

    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|svg|webp)$ {
        proxy_pass http://127.0.0.1:{{ app_port_gcli2api_api | default(30071) }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
}
