{
  "inbounds": [
    {%- set ns = namespace(first_inbound=true) -%}
    {%- set all_in_nodes = (docker_apps_singbox_processed_nodes | default(singbox_nodes)) + (singbox_extra_nodes | default([])) -%}
    {%- for node in all_in_nodes if not (node.external | default(false) | bool) -%}
    {%- if not ns.first_inbound %},
    {%- endif -%}
    {%- set ns.first_inbound = false -%}
    {%- set is_reality = node.reality | default(true) | bool -%}
    {%- set is_behind_nginx = node.behind_nginx | default(false) | bool -%}
    {%- set is_grpc = node.transport | default('') == 'grpc' -%}
    {%- set has_tls = not is_behind_nginx -%}
    {%- set has_flow = is_reality and not is_grpc and node.type == 'vless' -%}
    {%- set _pbk = node.relay_public_key | default(docker_apps_singbox_reality_public_key) -%}
    {%- set _sid = node.relay_short_id | default((docker_apps_singbox_short_ids_gen.stdout_lines | default(['']))[0] | default('')) -%}
    {%- if node.type == 'vless' %}
    {
      "type": "vless",
      "tag": "in-{{ node.name | regex_replace('[^a-zA-Z0-9-]', '') | lower }}",
      "listen": "{{ '127.0.0.1' if is_behind_nginx else docker_apps_singbox_inbound_listen }}",
      "listen_port": {{ node.port }},
      "users": [
        {
          "uuid": "{{ node.uuid }}"{% if has_flow %},
          "flow": "xtls-rprx-vision"{% endif %}
        }
      ]{% if has_tls %},
      "tls": {
        "enabled": true,
        "server_name": "{{ node.sni }}",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "{{ node.sni }}",
            "server_port": 443
          },
          "private_key": "{{ singbox_reality_private_key | default(docker_apps_singbox_reality_private_key | default('')) }}",
          "short_id": {{ singbox_reality_short_ids | default(docker_apps_singbox_short_ids_gen.stdout_lines | default([''])) | to_json }}
        }
      }{% endif %}{% if is_grpc %},
      "transport": {
        "type": "grpc",
        "service_name": "{{ node.service_name | default('') }}",
        "idle_timeout": "15s",
        "ping_timeout": "5s",
        "permit_without_stream": true
      }{% endif %}
    }
    {%- elif node.type == 'hysteria2' %}
    {
      "type": "hysteria2",
      "tag": "in-{{ node.name | regex_replace('[^a-zA-Z0-9-]', '') | lower }}",
      "listen": "{{ '127.0.0.1' if is_behind_nginx else docker_apps_singbox_inbound_listen }}",
      "listen_port": {{ node.port }},
      "users": [
        {
          "password": "{{ node.password }}"
        }
      ]{% if node.obfs is defined %},
      "obfs": {
        "type": "{{ node.obfs }}",
        "password": "{{ node.obfs_password }}"
      }{% endif %}{% if has_tls %},
      "tls": {
        "enabled": true,
        "server_name": "{{ node.sni | default(docker_apps_singbox_certificate_domain) }}",
        "certificate_path": "{{ node.certificate_path | default('/etc/letsencrypt/live/' ~ docker_apps_singbox_certificate_domain ~ '/fullchain.pem') }}",
        "key_path": "{{ node.key_path | default('/etc/letsencrypt/live/' ~ docker_apps_singbox_certificate_domain ~ '/privkey.pem') }}"
      }{% endif %}
    }
    {%- elif node.type == 'trojan' %}
    {
      "type": "trojan",
      "tag": "in-{{ node.name | regex_replace('[^a-zA-Z0-9-]', '') | lower }}",
      "listen": "{{ '127.0.0.1' if is_behind_nginx else docker_apps_singbox_inbound_listen }}",
      "listen_port": {{ node.port }},
      "users": [
        {
          "password": "{{ node.password }}"
        }
      ]{% if has_tls %},
      "tls": {
        "enabled": true,
        "server_name": "{{ node.sni | default(docker_apps_singbox_certificate_domain) }}",
        "certificate_path": "/etc/letsencrypt/live/{{ docker_apps_singbox_certificate_domain }}/fullchain.pem",
        "key_path": "/etc/letsencrypt/live/{{ docker_apps_singbox_certificate_domain }}/privkey.pem"
      }{% endif %}{% if node.transport | default('') == 'ws' %},
      "transport": {
        "type": "ws",
        "path": "{{ node.path | default('/') }}"
      }{% endif %}
    }
    {%- elif node.type == 'anytls' %}
    {
      "type": "anytls",
      "tag": "in-{{ node.name | regex_replace('[^a-zA-Z0-9-]', '') | lower }}",
      "listen": "{{ '127.0.0.1' if is_behind_nginx else docker_apps_singbox_inbound_listen }}",
      "listen_port": {{ node.port }},
      "users": [
        {
          "password": "{{ node.password }}"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "{{ node.sni | default(docker_apps_singbox_certificate_domain) }}",
        "certificate_path": "/etc/letsencrypt/live/{{ docker_apps_singbox_certificate_domain }}/fullchain.pem",
        "key_path": "/etc/letsencrypt/live/{{ docker_apps_singbox_certificate_domain }}/privkey.pem"
      }
    }
    {%- elif node.type == 'tuic' %}
    {
      "type": "tuic",
      "tag": "in-{{ node.name | regex_replace('[^a-zA-Z0-9-]', '') | lower }}",
      "listen": "{{ '127.0.0.1' if is_behind_nginx else docker_apps_singbox_inbound_listen }}",
      "listen_port": {{ node.port }},
      "users": [
        {
          "uuid": "{{ node.uuid }}",
          "password": "{{ node.password }}"
        }
      ],
      "congestion_control": "bbr",
      "zero_rtt_handshake": true,
      "heartbeat": "10s",
      "tls": {
        "enabled": true,
        "server_name": "{{ node.sni | default(docker_apps_singbox_certificate_domain) }}",
        "alpn": [
          "h3"
        ],
        "certificate_path": "/etc/letsencrypt/live/{{ docker_apps_singbox_certificate_domain }}/fullchain.pem",
        "key_path": "/etc/letsencrypt/live/{{ docker_apps_singbox_certificate_domain }}/privkey.pem"
      }
    }
    {%- endif -%}
    {%- endfor -%}

    {%- if singbox_zt_ip is defined and singbox_zt_ip | length > 0 -%}
    {%- if not ns.first_inbound -%},{%- endif -%}
    {# ZeroTier 内网接收端 (从 Relay 中继过来) #}
    {
      "type": "vless",
      "tag": "in-zt-relay",
      "listen": "{{ singbox_zt_ip }}",
      "listen_port": {{ singbox_zt_relay_port }},
      "users": [
        {
          "uuid": "{{ singbox_uuid_aws }}"
        }
      ]
    }
    {%- endif -%}
    {%- if auroraops_roles['services']['ip2free_gateway'] | default(false) -%}
    ,
    {
      "type": "hysteria2",
      "tag": "hy2-resi",
      "listen": "::",
      "listen_port": {{ app_port_singbox_hy2_resi }},
      "users": [
        {
          "password": "{{ hysteria_auth_password }}"
        }
      ],
      "obfs": {
        "type": "salamander",
        "password": "{{ hysteria_obfs_password }}"
      },
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/letsencrypt/live/{{ docker_apps_singbox_certificate_domain }}/fullchain.pem",
        "key_path": "/etc/letsencrypt/live/{{ docker_apps_singbox_certificate_domain }}/privkey.pem"
      }
    }
    {%- endif -%}
  ]
}
