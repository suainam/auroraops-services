{
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "remote",
        "server": "8.8.8.8",
        "server_port": 443,
        "path": "/dns-query"
      },
      {
        "type": "https",
        "tag": "local",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query"
      }
    ],
    "rules": [
      { "clash_mode": "Direct", "server": "local" },
      { "clash_mode": "Global", "server": "remote" }
    ],
    "final": "remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "address": ["172.19.0.1/30"],
      "auto_route": true,
      "strict_route": true,
      "stack": "system",
      "sniff": true
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "auto",
        "direct",
{%- for node in singbox_nodes %}
        "{{ node.name }}",
{%- endfor %}
        "auto"
      ],
      "default": "auto"
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
{%- for node in singbox_nodes %}
        "{{ node.name }}"{%- if not loop.last %},{% endif -%}
{%- endfor %}
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    {
      "type": "direct",
      "tag": "direct"
    },
{%- for node in singbox_nodes %}
{%- if node.type == 'vless' %}
    {
      "type": "vless",
      "tag": "{{ node.name }}",
      "server": "{{ node.server | default(singbox_domain) }}",
      "server_port": {{ 443 if node.behind_nginx | default(false) else node.port }},
      "uuid": "{{ node.uuid }}",
{%- if not node.transport is defined or node.transport == 'tcp' %}
{%- if node.reality | default(true) %}
      "flow": "xtls-rprx-vision",
{%- endif %}
{%- endif %}
      "tls": {
        "enabled": true,
        "server_name": "{{ node.sni }}",
        "utls": { "enabled": true, "fingerprint": "chrome" }
{%- if node.reality | default(true) %},
        "reality": {
          "enabled": true,
          "public_key": "{{ docker_apps_singbox_reality_public_key }}",
          "short_id": "{{ docker_apps_singbox_short_ids_gen.stdout_lines[0] | default('') }}"
        }
{%- endif %}
      },
{%- if node.transport is defined and node.transport == 'grpc' %}
      "transport": {
        "type": "grpc",
        "service_name": "{{ node.service_name }}"
      },
{%- endif %}
      "packet_encoding": "xudp"
    }{%- if not loop.last %},{% endif %}
{%- elif node.type == 'hysteria2' %}
    {
      "type": "hysteria2",
      "tag": "{{ node.name }}",
      "server": "{{ node.server | default(singbox_domain) }}",
      "server_port": {{ node.port }},
      "password": "{{ node.password }}",
{%- if node.obfs is defined %}
      "obfs": {
        "type": "{{ node.obfs }}",
        "password": "{{ node.obfs_password }}"
      },
{%- endif %}
      "tls": {
        "enabled": true,
{%- if node.sni is defined %}
        "server_name": "{{ node.sni }}",
{%- endif %}
        "alpn": ["{{ node.alpn | default('h3') }}"],
        "insecure": {{ node.insecure | default(false) | lower }}
      }
    }{%- if not loop.last %},{% endif %}
{%- endif %}
{%- endfor %}
  ],
  "route": {
    "auto_detect_interface": true,
    "final": "proxy",
    "default_domain_resolver": {
      "server": "remote",
      "strategy": "ipv4_only"
    }
  }
}
