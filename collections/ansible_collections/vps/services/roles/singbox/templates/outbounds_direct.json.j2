{
  "outbounds": [
    { "type": "direct", "tag": "direct-out" },
    {%- if docker_apps_singbox_warp_enabled | default(false) | bool %}
    {
      "type": "socks",
      "tag": "warp-out",
      "server": "127.0.0.1",
      "server_port": {{ docker_apps_singbox_warp_port | default(app_port_singbox_warp | default(40000)) }}
    },
    {%- endif %}
    { "type": "block", "tag": "block" }
{% if singbox_relay_upstreams | default([]) | length > 0 %},
    {
      "type": "urltest",
      "tag": "relay-failover-cluster",
      "outbounds": [
{% for upstream in singbox_relay_upstreams %}
        "relay-upstream-{{ upstream.name }}"{% if not loop.last %},{% endif %}
{% endfor %}
      ],
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "1m",
      "tolerance": 50
    }
{% for upstream in singbox_relay_upstreams %},
    {
      "type": "{{ upstream.type }}",
      "tag": "relay-upstream-{{ upstream.name }}",
      "server": "{{ upstream.server }}",
      "server_port": {{ upstream.port }},
      {% if upstream.type == 'vless' %}"uuid": "{{ upstream.uuid }}",
      "flow": "xtls-rprx-vision",
      "tls": { "enabled": true, "server_name": "{{ upstream.sni }}", "utls": { "enabled": true, "fingerprint": "chrome" }, "reality": { "enabled": true, "public_key": "{{ upstream.public_key }}", "short_id": "{{ upstream.short_id }}" } }
      {% else %}"password": "{{ upstream.password }}",
      "tls": { "enabled": true, "server_name": "{{ upstream.sni }}", "insecure": {{ upstream.insecure | default(false) | lower }} },
      "obfs": { "type": "salamander", "password": "{{ upstream.obfs_password }}" }
      {% endif %}
    }
{% endfor %}
{% endif %}
{% if singbox_smart_unlock_enabled | default(true) | bool %},
    {
      "type": "vless",
      "tag": "out-nat-jp3",
      "server": "{{ singbox_jp3_host | default(hostvars['nat-jp3'].nat_public_ipv4 | default('')) }}",
      "server_port": 30052,
      "uuid": "{{ singbox_uuid_aws }}",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "www.cloudflare.com",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "{{ hostvars['nat-jp3'].singbox_reality_public_key | default('') }}",
          "short_id": "{{ hostvars['nat-jp3'].singbox_reality_short_ids | default([''], true) | first }}"
        }
      }
    },
    {
      "type": "vless",
      "tag": "out-cc15",
      "server": "{{ singbox_cc15_host | default('117.55.226.100') }}",
      "server_port": 30053,
      "uuid": "{{ singbox_uuid_cf }}",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "www.cloudflare.com",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "aEeIAIPEuV0bsIk19W7hnpbTgRd6oPBcrB-rc71oww4",
          "short_id": "15d9565cee5e6844"
        }
      }
    },
    {
      "type": "vless",
      "tag": "out-nat-hk216",
      "server": "{{ singbox_hk216_host | default('38.76.219.14') }}",
      "server_port": 30052,
      "uuid": "{{ singbox_uuid_aws }}",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "aws.amazon.com",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "NiSfj3h0cASa44FkrktDz8oV3dN2ic8iwlTn_w02Mxw",
          "short_id": "d4361ef75a54a076"
        }
      }
    },
    {
      "type": "vless",
      "tag": "out-nat-hk084",
      "server": "{{ singbox_hk084_host | default('38.76.189.196') }}",
      "server_port": 30052,
      "uuid": "{{ singbox_uuid_aws }}",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "www.cloudflare.com",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "3hleuNs8hbUaxd9b-C50Q7gR8DlOJCYkS1yF0BQbuWc",
          "short_id": "ecf55366167941a8"
        }
      }
    },
    {
      "type": "urltest",
      "tag": "ai-restricted-cluster",
      "outbounds": [
        "out-nat-jp3",
        "out-cc15",
        "direct-out"
      ],
      "url": "http://www.google.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    {
      "type": "urltest",
      "tag": "media-asia-cluster",
      "outbounds": [
        "out-nat-jp3",
        "out-nat-hk216",
        "out-nat-hk084",
        "out-cc15",
        "direct-out"
      ],
      "url": "http://www.google.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    }
{% endif %}
  ]
}
