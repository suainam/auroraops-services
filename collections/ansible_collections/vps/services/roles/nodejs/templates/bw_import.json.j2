{# Bitwarden JSON Import Template #}
{# Generated by bw_sync for batch import #}
{
  "encrypted": false,
  "folders": [
    {
      "id": "{{ nodejs__bw_sync_folder_id }}",
      "name": "{{ bw_sync_root_folder }}"
    }
  ],
  "items": [
{% for item in nodejs__bw_sync_to_create %}
    {
      "id": null,
      "organizationId": null,
      "folderId": "{{ nodejs__bw_sync_folder_id }}",
{% if item.type == 'login' %}
      "type": 1,
      "reprompt": 0,
      "name": "{{ item.name }}",
      "notes": "Synced from vault.yml [{{ item.category }}]",
      "favorite": false,
      "login": {
        "username": "{{ item.username }}",
        "password": "{{ item.password }}",
        "totp": null
      }
{% else %}
      "type": 2,
      "reprompt": 0,
      "name": "{{ item.name }}",
      "notes": "{{ item.content | replace('\\', '\\\\') | replace('"', '\\"') | replace('\n', '\\n') }}",
      "favorite": false,
      "secureNote": {
        "type": 0
      }
{% endif %}
    }{{ '' if loop.last else ',' }}
{% endfor %}
  ]
}
