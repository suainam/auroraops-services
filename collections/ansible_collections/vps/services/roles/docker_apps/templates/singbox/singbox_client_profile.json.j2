{
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "remote",
        "server": "8.8.8.8",
        "server_port": 443,
        "path": "/dns-query"
      },
      {
        "type": "https",
        "tag": "local",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query"
      }
    ],
    "rules": [
      { "clash_mode": "Direct", "server": "local" },
      { "clash_mode": "Global", "server": "remote" }
    ],
    "final": "remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "address": ["172.19.0.1/30"],
      "auto_route": true,
      "strict_route": true,
      "stack": "system",
      "sniff": true
    }
  ],
  "outbounds": [
    {%- set raw_sub_nodes = (docker_apps_singbox_processed_nodes | default(singbox_nodes)) + (singbox_extra_nodes | default([])) -%}
    {%- set all_sub_nodes = raw_sub_nodes | rejectattr('name', 'search', 'resi') | list if not (auroraops_roles['services']['ip2free_gateway'] | default(false) | bool) else raw_sub_nodes -%}
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "auto-latency",
        "auto-stable",
        "direct",
{%- for node in all_sub_nodes %}
{%- set has_flag = node.name is regex('^[^\\x00-\\x7f]') -%}
{%- set current_flag = docker_apps_country_flags[docker_apps_singbox_host_country | default('UNKNOWN')] | default('🌍') -%}
{%- set display_name = node.name if has_flag else (current_flag + ' ' + node.name) -%}
        "{{ display_name }}",
{%- endfor %}
        "auto-latency"
      ],
      "default": "auto-latency"
    },
    {
      "type": "urltest",
      "tag": "auto-latency",
      "outbounds": [
{%- for node in all_sub_nodes %}
{%- set has_flag = node.name is regex('^[^\\x00-\\x7f]') -%}
{%- set current_flag = docker_apps_country_flags[docker_apps_singbox_host_country | default('UNKNOWN')] | default('🌍') -%}
{%- set display_name = node.name if has_flag else (current_flag + ' ' + node.name) -%}
        "{{ display_name }}"{%- if not loop.last %},{% endif -%}
{%- endfor %}
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "1m",
      "tolerance": 50
    },
    {
      "type": "urltest",
      "tag": "auto-stable",
      "outbounds": [
{%- for node in all_sub_nodes %}
{%- set has_flag = node.name is regex('^[^\\x00-\\x7f]') -%}
{%- set current_flag = docker_apps_country_flags[docker_apps_singbox_host_country | default('UNKNOWN')] | default('🌍') -%}
{%- set display_name = node.name if has_flag else (current_flag + ' ' + node.name) -%}
        "{{ display_name }}"{%- if not loop.last %},{% endif -%}
{%- endfor %}
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 150
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {%- set node_ns = namespace(first_node=true) -%}
{%- for node in all_sub_nodes %}
{%- set has_flag = node.name is regex('^[^\\x00-\\x7f]') -%}
{%- set current_flag = docker_apps_country_flags[docker_apps_singbox_host_country | default('UNKNOWN')] | default('🌍') -%}
{%- set display_name = node.name if has_flag else (current_flag + ' ' + node.name) -%}
{%- if node.type in ['vless', 'trojan', 'hysteria2', 'anytls', 'tuic'] %}
{%- if not node_ns.first_node %},{%- endif %}
{%- set node_ns.first_node = false %}
{%- if node.type == 'vless' %}
    {
      "type": "vless",
      "tag": "{{ display_name }}",
      "server": "{{ node.server | default(singbox_domain) }}",
      "server_port": {{ 443 if node.behind_nginx | default(false) else node.port }},
      "uuid": "{{ node.uuid }}",
{%- if not node.transport is defined or node.transport == 'tcp' %}
{%- if node.reality | default(true) %}
      "flow": "xtls-rprx-vision",
{%- endif %}
{%- endif %}
      "tls": {
        "enabled": true,
        "server_name": "{{ node.sni }}",
        "utls": { "enabled": true, "fingerprint": "chrome" }
{%- if node.reality | default(true) %},
        "reality": {
          "enabled": true,
          "public_key": "{{ docker_apps_singbox_reality_public_key }}",
          "short_id": "{{ docker_apps_singbox_short_ids_gen.stdout_lines[0] | default('') }}"
        }
{%- endif %}
{%- if node.transport is defined and node.transport == 'grpc' %},
        "alpn": ["h2"]
{%- endif %}
      },
{%- if node.transport is defined and node.transport == 'grpc' %}
      "transport": {
        "type": "grpc",
        "service_name": "{{ node.service_name }}",
        "idle_timeout": "15s",
        "ping_timeout": "5s",
        "permit_without_stream": true
      },
{%- endif %}
      "packet_encoding": "xudp"
    }
{%- elif node.type == 'trojan' %}
    {
      "type": "trojan",
      "tag": "{{ display_name }}",
      "server": "{{ node.server | default(singbox_domain) }}",
      "server_port": 443,
      "password": "{{ node.password }}",
      "tls": {
        "enabled": true,
        "server_name": "{{ node.sni | default('') }}",
        "insecure": false
      }
{%- if node.transport == 'ws' %},
      "transport": {
        "type": "ws",
        "path": "{{ node.path | default('/') }}"
{%- if node.host is defined %},
        "headers": {
          "Host": "{{ node.host }}"
        }
{%- endif %}
      }
{%- endif %}
    }
{%- elif node.type == 'hysteria2' %}
     {
       "type": "hysteria2",
       "tag": "{{ display_name }}",
       "server": "{{ node.server | default(singbox_domain) }}",
       "server_port": {{ node.port }},
       "password": "{{ node.password }}",
{%- if node.obfs is defined %}
       "obfs": {
         "type": "{{ node.obfs }}",
         "password": "{{ node.obfs_password }}"
       },
{%- endif %}
       "tls": {
         "enabled": true,
{%- if node.sni is defined %}
         "server_name": "{{ node.sni }}",
{%- endif %}
         "alpn": ["{{ node.alpn | default('h3') }}"],
         "insecure": {{ node.insecure | default(false) | lower }}
       }
     }
{%- elif node.type == 'anytls' %}
     {
       "type": "anytls",
       "tag": "{{ display_name }}",
       "server": "{{ node.server | default(singbox_domain) }}",
       "server_port": {{ node.port }},
       "password": "{{ node.password }}",
       "tls": {
         "enabled": true,
{%- if node.sni is defined %}
         "server_name": "{{ node.sni }}",
{%- endif %}
         "insecure": {{ node.insecure | default(false) | lower }}
       }
     }
{%- elif node.type == 'tuic' %}
     {
       "type": "tuic",
       "tag": "{{ display_name }}",
       "server": "{{ node.server | default(singbox_domain) }}",
       "server_port": {{ node.port }},
       "uuid": "{{ node.uuid }}",
       "password": "{{ node.password }}",
       "congestion_control": "bbr",
       "udp_relay_mode": "native",
       "zero_rtt_handshake": true,
       "heartbeat": "10s",
       "tls": {
         "enabled": true,
{%- if node.sni is defined %}
         "server_name": "{{ node.sni }}",
{%- endif %}
         "alpn": ["h3"],
         "insecure": {{ node.insecure | default(false) | lower }}
       }
     }
{%- endif %}
{%- endif %}
{%- endfor %}
  ],
  "route": {
    "auto_detect_interface": true,
    "final": "proxy",
    "default_domain_resolver": {
      "server": "remote",
      "strategy": "ipv4_only"
    }
  }
}
