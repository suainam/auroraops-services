# Required SMTP sender settings
SMTP_HOST={{ opcotoai_smtp_host | default('smtp.example.com') }}
SMTP_PORT={{ opcotoai_smtp_port | default('465') }}
SMTP_SECURE={{ opcotoai_smtp_secure | default('true') }}
SMTP_USER={{ opcotoai_smtp_user | default('service@example.com') }}
SMTP_PASSWORD={{ opcotoai_smtp_password | default('replace-me') }}
SMTP_FROM={{ opcotoai_smtp_from | default('service@example.com') }}
SMTP_FROM_NAME={{ opcotoai_smtp_from_name | default('Mail Console') }}

# Optional receive/send integrations
OPC_MAIL_BASE={{ opcotoai_mail_base | default('') }}
OPC_MAIL_DOMAINS={{ opcotoai_mail_domains | default('') }}
TELE_OPC_BASE={{ opcotoai_tele_base | default('') }}
TELE_OPC_DEV_TOKEN={{ opcotoai_tele_dev_token | default('') }}

# Cloudflare FreeMail (Workers + D1 + R2 + Email Routing)
FREEMAIL_BASE={{ opcotoai_smtp_freemail_base | default(docker_apps_preserved_freemail_base | default(preserved_cloudflare_api_base | default(''))) }}
FREEMAIL_API_KEY={{ vault_opcotoai_smtp_freemail_jwt_token | default(vault_opcotoai_smtp_freemail_api_key | default('')) }}
