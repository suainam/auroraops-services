proxy-providers:
{% for provider in capability_providers %}
{% if provider.enabled | default(true) %}
{#-
  Prefix normalisation. `additional-prefix` reaches this template as a bare
  string from the resolver, but the vaulted provider list carries it as a
  single-element YAML list. Coercing that list straight to text produced the
  literal `["hk084-resi"]` on every node, because Jinja renders a list as its
  Python repr. Normalise here rather than trusting every writer to agree:
  take the first element of a list, trim, and guarantee a single compact pair of
  brackets. `(prefix ~ ' ')` below then behaves for both shapes.
-#}
{% set raw_prefix = provider['additional-prefix'] | default('[' ~ provider.name ~ ']') %}
{% set flat_prefix = (raw_prefix if raw_prefix is string else (raw_prefix | first)) | string | trim %}
{% set prefix = flat_prefix if flat_prefix.startswith('[') else '[' ~ flat_prefix ~ ']' %}
{% set provider_id = provider['provider-id'] | default(provider.name) %}
  source-{{ provider_id }}:
    type: http
    url: "https://{{ singbox_domain }}/{{ sub_store_capability_source_provider_suffix }}-{{ provider_id | urlencode }}.yaml"
    path: ./proxy_providers/{{ provider_id }}.yaml
    interval: 3600
    filter: "(?i)^(?!.*(?:剩余流量|流量剩余|套餐到期|距离下次重置|重置剩余|更换客户端|请每月更)).*$"
    override:
      additional-prefix: {{ (prefix ~ ' ') | to_json }}
{% if provider.role | default('') == 'metered' or provider.metered | default(false) or 'sakura' in provider.name or 'sk' in provider.name %}
    health-check:
      enable: false
{% else %}
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
      timeout: 5000
      lazy: true
      expected-status: 204
{% endif %}
{% endif %}
{% endfor %}
