# Mihomo profile backed by the private Sub-Store proxy provider.

mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: false

geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb"

# Nodes are loaded dynamically from Sub-Store.
proxies: []
proxy-providers:
  aurora-substore:
    type: http
    url: "https://{{ singbox_domain }}/{{ sub_store_mihomo_provider_suffix }}"
    path: ./proxy_providers/aurora-substore.yaml
    interval: 3600
    health-check:
      enable: true
      url: https://cp.cloudflare.com/generate_204
      interval: 300
      timeout: 5000
      lazy: true
      expected-status: 204

{% include 'sub_store_capability_profile/rule_providers.yaml.j2' %}

proxy-groups:
  - name: "🚀 节点选择"
    type: select
    proxies:
      - "⚡️ 自动延迟"
      - "🛡️ 自动稳定"
      - "🌍 全部节点"
      - DIRECT

  - name: "🌍 全部节点"
    type: select
    use:
      - aurora-substore

  - name: "⚡️ 自动延迟"
    type: url-test
    use:
      - aurora-substore
    url: https://cp.cloudflare.com/generate_204
    interval: 60
    tolerance: 50
    lazy: true

  - name: "🛡️ 自动稳定"
    type: fallback
    use:
      - aurora-substore
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    lazy: true

  # Policy groups referenced by the ordered rules below.
  - name: "🚀 默认代理"
    type: select
    proxies:
      - "🚀 节点选择"
      - "⚡️ 自动延迟"
      - "🛡️ 自动稳定"
      - DIRECT

  - name: "⚡ 快速节点"
    type: select
    proxies:
      - "⚡️ 自动延迟"
      - "🛡️ 自动稳定"
      - "🚀 节点选择"
      - DIRECT

  - name: "🤖 AI 服务"
    type: select
    proxies:
      - "🛡️ 自动稳定"
      - "⚡️ 自动延迟"
      - "🚀 节点选择"
      - DIRECT

  - name: "📺 B站港澳"
    type: url-test
    use:
      - aurora-substore
    filter: "(?i)🇭🇰|港|hk|hong\\s*kong|🇹🇼|台|tw|taiwan"
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    lazy: true

  - name: "⚡ 千兆极速"
    type: select
    proxies:
      - "⚡️ 自动延迟"
      - "🛡️ 自动稳定"
      - "🚀 节点选择"
      - DIRECT

  - name: "🏦 金融与交易所"
    type: select
    proxies:
      - "🛡️ 自动稳定"
      - "🚀 节点选择"
      - DIRECT

  - name: "🍎 Apple 低价区"
    type: select
    proxies:
      - DIRECT
      - "🚀 节点选择"
      - "🛡️ 自动稳定"

rules:
{% include 'sub_store_capability_profile/private_rules.yaml.j2' %}
{% include 'sub_store_capability_profile/rules.yaml' %}

dns:
  enable: true
  ipv6: false
  listen: 0.0.0.0:1053
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  proxy-server-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  fake-ip-filter:
    - "{{ singbox_domain }}"
{% for domain in sub_store_capability_user_fake_ip_filter | default([]) %}
    - "{{ domain }}"
{% endfor %}
