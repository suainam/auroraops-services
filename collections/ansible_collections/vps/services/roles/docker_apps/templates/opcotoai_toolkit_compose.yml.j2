name: opcotoai-toolkit

services:
  gateway:
    image: nginx:1.27-alpine
    ports:
      - "127.0.0.1:{{ app_port_opcotoai_smtp | default(30016) }}:80"
    volumes:
      - ./config/gateway/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      smtp:
        condition: service_started
    restart: unless-stopped
    mem_limit: 128M
    mem_reservation: 32M
    cpus: "0.25"

  smtp:
    build:
      context: ./apps/smtp
    env_file:
      - ./config/smtp/.env
    volumes:
      - smtp-data:/var/lib/smtp-console
      - mail-console-data:/var/lib/mail-console
    restart: unless-stopped
    mem_limit: 512M
    mem_reservation: 128M
    cpus: "0.5"

# grok service removed: AaronL725/grok-register is now managed by the
# vps.services.grok_register standalone Role (Issue #162 / PR #169).
# The /grok/ route is served by the grok_register role via Nginx once #166 is deployed.

volumes:
  smtp-data:
  mail-console-data:
