    interval: 180
    timeout: 4000
    lazy: true
    hidden: true

  - name: "🇸🇬 新加坡 · 极速"
    type: fallback
    proxies:
      - "🇸🇬 专线 · 极速"
      - "🇸🇬 大带宽 · 极速"
