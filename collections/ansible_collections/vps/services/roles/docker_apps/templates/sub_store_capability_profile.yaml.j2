# Mihomo profile backed by Sub-Store sources with pure keyword-based lightweight grouping (#29).

mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: false
enable-process: true
find-process-mode: always

profile:
  store-selected: true

geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb"
  asn: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/GeoLite2-ASN.mmdb"

proxies: []
{% set capability_providers = docker_apps_sub_store_capability_providers %}

{% include 'sub_store_capability_profile/proxy_providers.yaml.j2' %}

proxy-groups:
  # ========================================================
  # 1. 顶层业务入口 (Top-Level Services, 常用排在最前面)
  # ========================================================
  - name: "🤖 AI 服务"
    type: select
    proxies:
      - "🛡️ 自建优先 (AI 容灾)"
      - "🖥️ 自建 VPS"
      - "🧭 自建 NAT"
      - "🌐 外部 BP · AI"
      - "🌸 外部 SK · 全部"
      - DIRECT

  - name: "🐙 GitHub"
    type: select
    proxies:
      - "🖥️ 自建 VPS"
      - "🧭 自建 NAT"
      - "⚡ BP 千兆优选"
      - "🌸 外部 SK · 全部"
      - DIRECT

  - name: "📹 YouTube"
    type: select
    proxies:
      - "⚡ BP 千兆优选"
      - "🖥️ 自建 VPS"
      - "🧭 自建 NAT"
      - "🌐 外部 BP · 全部"
      - "🌸 外部 SK · 全部"
      - DIRECT

  - name: "📺 B站港澳台"
    type: select
    proxies:
      - "🧭 自建 NAT · 港澳"
      - "🌐 外部 BP · 港澳台"
      - "🌸 外部 SK · 港澳台"
      - DIRECT

  - name: "🚀 默认代理"
    type: select
    proxies:
      - "⚡ BP 千兆优选"
      - "🛡️ 自建优先 (AI 容灾)"
      - "🖥️ 自建 VPS"
      - "🧭 自建 NAT"
      - "🌐 外部 BP · 全部"
      - "🌸 外部 SK · 全部"
      - DIRECT

  # ========================================================
  # 2. 底层节点实体池 (Entity Pools, 纯手动查看与调试，排在后面)
  # ========================================================
  - name: "🖥️ 自建 VPS"
    type: select
    use:
      - source-cc15
      - source-qqg1299

  - name: "🧭 自建 NAT"
    type: select
    use:
      - source-nat-hk084
      - source-nat-hk216
      - source-nat-jp3

  - name: "🌐 外部 BP · 全部"
    type: select
    use:
      - source-baipiao

  - name: "🌸 外部 SK · 全部"
    type: select
    use:
      - source-sakura

  # ========================================================
  # 3. 内部策略与定向子组 (全部 hidden: true, 前端彻底隐形)
  # ========================================================
  - name: "🛡️ 自建优先 (AI 容灾)"
    type: fallback
    proxies:
      - "🖥️ 自建 VPS · AI"
      - "🧭 自建 NAT · AI"
      - "🌐 外部 BP · AI"
      - DIRECT
    url: https://chatgpt.com/cdn-cgi/trace
    interval: 300
    timeout: 3000
    lazy: true
    hidden: true

  - name: "⚡ BP 千兆优选"
    type: url-test
    use:
      - source-baipiao
    filter: "(?i)1000M|神速|快"
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    lazy: true
    hidden: true

  - name: "🖥️ 自建 VPS · AI"
    type: fallback
    use:
      - source-cc15
      - source-qqg1299
    url: https://chatgpt.com/cdn-cgi/trace
    interval: 300
    lazy: true
    hidden: true

  - name: "🧭 自建 NAT · AI"
    type: fallback
    use:
      - source-nat-hk084
      - source-nat-hk216
      - source-nat-jp3
    url: https://chatgpt.com/cdn-cgi/trace
    interval: 300
    lazy: true
    hidden: true

  # 精准匹配真正的 AI 关键词，排除 [baipiao] 自身拼音干扰
  - name: "🌐 外部 BP · AI"
    type: fallback
    use:
      - source-baipiao
    filter: "(?i)Gemini|ChatGPT|GPT|直连AI|[-_\\s]AI|AI[-_\\s$]"
    url: https://chatgpt.com/cdn-cgi/trace
    interval: 300
    lazy: true
    hidden: true

  # B站港澳台专用定向子组
  - name: "🧭 自建 NAT · 港澳"
    type: fallback
    use:
      - source-nat-hk084
      - source-nat-hk216
      - source-nat-jp3
    filter: "(?i)🇭🇰|港|hk|hong\\s*kong|🇹🇼|台|tw|taiwan"
    url: https://www.gstatic.com/generate_204
    interval: 300
    lazy: true
    hidden: true

  - name: "🌐 外部 BP · 港澳台"
    type: fallback
    use:
      - source-baipiao
    filter: "(?i)🇭🇰|香港|🇹🇼|台湾|HK|TW"
    url: https://www.gstatic.com/generate_204
    interval: 300
    lazy: true
    hidden: true

  - name: "🌸 外部 SK · 港澳台"
    type: select
    use:
      - source-sakura
    filter: "(?i)🇭🇰|香港|🇹🇼|台湾|HK|TW"
    hidden: true

  # 兼容私有规则中的 ⚡ 快速节点 引用
  - name: "⚡ 快速节点"
    type: select
    proxies:
      - "⚡ BP 千兆优选"
      - "🖥️ 自建 VPS"
      - DIRECT
    hidden: true

{% include 'sub_store_capability_profile/rule_providers.yaml.j2' %}

{% include 'sub_store_capability_profile/routing_dns.yaml.j2' %}
