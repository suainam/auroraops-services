{% endfor %}
    filter: "(?i)(\\[JP\\]|日本).*(专线|IEPL|IPLC)"
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    lazy: true
    hidden: true

  - name: "🇯🇵 大带宽 · 极速"
    type: fallback
    use:
{% for pid in airport_providers.items %}
