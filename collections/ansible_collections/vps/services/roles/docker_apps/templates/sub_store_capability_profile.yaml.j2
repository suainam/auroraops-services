    interval: 180
    timeout: 4000
    lazy: true
    hidden: true
  - name: "🇺🇸 美国 · 极速"
    type: fallback
    proxies:
      - "🇺🇸 专线 · 极速"
      - "🇺🇸 大带宽 · 极速"
      - "🇺🇸 洛杉矶独享"
