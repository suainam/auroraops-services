# Mihomo profile backed by Sub-Store sources with data-driven keyword grouping (#29, #46, #47).

mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: false
enable-process: true
find-process-mode: always

profile:
  store-selected: true

geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb"
  asn: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/GeoLite2-ASN.mmdb"

proxies: []
{% set capability_providers = docker_apps_sub_store_capability_providers | default([]) %}
{% include 'sub_store_capability_profile/proxy_providers.yaml.j2' %}
{% set vps_providers     = namespace(items=[]) %}
{% set nat_providers     = namespace(items=[]) %}
{% set bp_providers      = namespace(items=[]) %}
{% set sk_providers      = namespace(items=[]) %}
{% set airport_providers = namespace(items=[]) %}
{% for p in capability_providers %}
{% if p.enabled | default(true) %}
{% set pid = p['provider-id'] | default(p.name) %}
{% set dg = p['display-group'] | default('') %}
{% if not dg %}
  {% if 'nat' in p.name | lower %}
    {% set dg = 'NAT' %}
  {% elif 'bp' in p.name | lower or 'baipiao' in p.name | lower %}
    {% set dg = 'BP' %}
  {% elif 'sk' in p.name | lower or 'sakura' in p.name | lower %}
    {% set dg = 'SK' %}
  {% elif 'cc15' in p.name | lower or 'qqg1299' in p.name | lower or 'vps' in p.name | lower or p.owned | default(false) %}
    {% set dg = 'VPS' %}
  {% else %}
    {% set dg = 'AIRPORT' %}
  {% endif %}
{% endif %}
{% if dg == 'VPS' %}
{% set vps_providers.items = vps_providers.items + [pid] %}
{% elif dg == 'NAT' %}
{% set nat_providers.items = nat_providers.items + [pid] %}
{% elif dg == 'BP' %}
{% set bp_providers.items = bp_providers.items + [pid] %}
{% elif dg == 'SK' %}
{% set sk_providers.items = sk_providers.items + [pid] %}
{% elif dg == 'AIRPORT' %}
{% set airport_providers.items = airport_providers.items + [pid] %}
{% endif %}
{% endif %}
{% endfor %}

{# --- 全局通用特征标签 (SSOT) --- #}
{% set tag_ai        = '(?:\x5c\x5c[AI\x5c\x5c]|(?:^|[^a-z])ai(?:[^a-z]|$)|chatgpt|gpt|claude|gemini|解锁)' %}
{% set tag_iplc      = '(?:\x5c\x5c[专线\x5c\x5c]|专线|IEPL|IPLC)' %}
{% set tag_bandwidth = '(?:\x5c\x5c[千兆\x5c\x5c]|\x5c\x5c[大带宽\x5c\x5c]|千兆|1000M|1\x5c\x5c.8G|大带宽|BGP|中转)' %}
{% set tag_normal    = '(?:\x5c\x5c[普通\x5c\x5c]|普通)' %}

{# --- 全局通用测速与健康检查参数 --- #}
{% set speed_test_url = 'https://www.gstatic.com/generate_204' %}
{% set ai_test_url    = 'https://chatgpt.com/cdn-cgi/trace' %}
{% set check_interval = 180 %}
{% set check_timeout  = 4000 %}

{# --- 五大核心地域元数据定义 --- #}
{% set regions = [
  {'code': 'HK', 'flag': '🇭🇰', 'name': '香港'},
  {'code': 'TW', 'flag': '🇹🇼', 'name': '台湾'},
  {'code': 'JP', 'flag': '🇯🇵', 'name': '日本'},
  {'code': 'SG', 'flag': '🇸🇬', 'name': '新加坡'},
  {'code': 'US', 'flag': '🇺🇸', 'name': '美国', 'extra_proxy': '🇺🇸 [VPS] CC15-千兆-Vless-静态'}
] %}

proxy-groups:
  # ========================================================
  # 1. 顶层业务入口 (Top-Level Services, 客户端仅暴露这 5 个)
  # ========================================================
  # 1. 默认代理 (极简 3 大场景)
  - name: "🚀 默认代理"
    type: select
    proxies:
      - "⚡ 千兆极速"
      - "💰 低倍率走廊"
      - DIRECT

  # 2. 千兆极速 (合并视频开发与 Telegram，形式化统一港台日新美五大区)
  - name: "⚡ 千兆极速"
    type: select
    proxies:
      - "⚡ 自动优选"
      - "🇭🇰 香港 · 极速"
      - "🇹🇼 台湾 · 极速"
      - "🇯🇵 日本 · 极速"
      - "🇸🇬 新加坡 · 极速"
      - "🇺🇸 美国 · 极速"
      - DIRECT

  # 3. AI 服务 (地域绝对闭环手选，严禁包含 DIRECT)
  - name: "🤖 AI 服务"
    type: select
    proxies:
      - "🇺🇸 美国 · AI"
      - "🇯🇵 日本 · AI"
      - "🇸🇬 新加坡 · AI"
      - "🇹🇼 台湾 · AI"

  # 4. 金融与交易所 (纯手动 select，严格物理隔离公共机场，自建双保险，严禁 DIRECT)
  - name: "🏦 金融与交易所"
    type: select
    proxies:
      - "🇹🇼 台湾 · 金融"
      - "🇭🇰 香港 · 金融"
      - "🇺🇸 美国 · 金融"
      - "🇯🇵 日本 · 金融"
      - "🇸🇬 新加坡 · 金融"
      - "🌐 紧急专线逃生通道"
  # 5. Apple 低价区 (纯手动 select，免开全局注册/充值)
  - name: "🍎 Apple 低价区"
    type: select
    proxies:
      - DIRECT
      - "🇹🇷 土耳其"
      - "🇳🇬 尼日利亚"
      - "🇦🇷 阿根廷"
      - "🇮🇳 印度"
      - "🇵🇰 巴基斯坦"
      - "🇷🇺 俄罗斯"
      - "🇯🇵 日本 · 极速"
      - "🌸 SK"
  # ========================================================
  # 2. 底层节点实体池 (Entity Pools, 纯手动查看与单选)
  # ========================================================
  - name: "🖥️ VPS"
    type: select
    use:
{% for pid in vps_providers.items %}
      - source-{{ pid }}
{% endfor %}

  - name: "🧭 NAT"
    type: select
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}

  - name: "⚡ YF"
    type: select
    proxies:
      - "⚡ YF·自动优选"
    use:
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}

  - name: "🌐 BP"
    type: select
    proxies:
      - "🌐 BP·自动优选"
    use:
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}

  - name: "🌸 SK"
    type: select
    use:
{% for pid in sk_providers.items %}
      - source-{{ pid }}
{% endfor %}

  # ========================================================
  # 3. 内部定向与能力子组 (全部 hidden: true, 前端隐形)
  # ========================================================
  # 💰 低倍率走廊
  - name: "💰 低倍率走廊"
    type: select
    use:
{% for pid in airport_providers.items + bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)0\\.1|0\\.01|低倍"
    hidden: true

  # --------------------------------------------------------
  # 极速地域五大区 (自动优选 + 国际流媒体 + 港台日新美)
  # --------------------------------------------------------
  - name: "⚡ 自动优选"
    type: fallback
    proxies:
      - "🇭🇰 香港 · 极速"
      - "🇹🇼 台湾 · 极速"
      - "🇯🇵 日本 · 极速"
      - "🇸🇬 新加坡 · 极速"
      - "🇺🇸 美国 · 极速"
    url: {{ speed_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true

  - name: "⚡ 国际流媒体"
    type: fallback
    proxies:
      - "🇸🇬 新加坡 · 极速"
      - "🇯🇵 日本 · 极速"
      - "🇺🇸 美国 · 极速"
      - "🇹🇼 台湾 · 极速"
    url: {{ speed_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true

{% for r in regions %}
  - name: "{{ r.flag }} {{ r.name }} · 极速"
    type: fallback
    proxies:
      - "{{ r.flag }} 专线 · 极速"
      - "{{ r.flag }} 千兆 · 极速"
      - "{{ r.flag }} 大带宽 · 极速"
      - "{{ r.flag }} 普通 · 极速"
{% if r.extra_proxy is defined %}
      - "{{ r.extra_proxy }}"
{% endif %}
    url: {{ speed_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true
{% endfor %}

  # 极速内部细分专线、千兆大带宽与普通子池 (hidden: true)
{% for r in regions %}
  - name: "{{ r.flag }} 专线 · 极速"
    type: fallback
    use:
{% for pid in airport_providers.items + bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)(\\[{{ r.code }}\\]|{{ r.name }}).*{{ tag_iplc }}"
    url: {{ speed_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true

  - name: "{{ r.flag }} 千兆 · 极速"
    type: fallback
    use:
{% for pid in airport_providers.items + bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% if r.code == 'JP' %}
{% for pid in nat_providers.items if 'jp' in pid | lower %}
      - source-{{ pid }}
{% endfor %}
{% endif %}
{% if r.code == 'US' %}
{% for pid in vps_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% endif %}
    filter: "(?i)(\\[{{ r.code }}\\]|{{ r.name }}).*{{ tag_bandwidth }}"
    url: {{ speed_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true

  - name: "{{ r.flag }} 大带宽 · 极速"
    type: fallback
    use:
{% for pid in airport_providers.items + bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% if r.code == 'JP' %}
{% for pid in nat_providers.items if 'jp' in pid | lower %}
      - source-{{ pid }}
{% endfor %}
{% endif %}
{% if r.code == 'US' %}
{% for pid in vps_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% endif %}
    filter: "(?i)(\\[{{ r.code }}\\]|{{ r.name }}).*{{ tag_bandwidth }}"
    url: {{ speed_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true
  - name: "{{ r.flag }} 普通 · 极速"
    type: fallback
    use:
{% for pid in airport_providers.items + bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)(\\[{{ r.code }}\\]|{{ r.name }})"
    url: {{ speed_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true
{% endfor %}

  - name: "⚡ YF·自动优选"
    type: url-test
    use:
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
    url: {{ speed_test_url }}
    interval: 300
    tolerance: 50
    lazy: true
    hidden: true

  - name: "🌐 BP·自动优选"
    type: url-test
    use:
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    url: {{ speed_test_url }}
    interval: 300
    tolerance: 50
    lazy: true
    hidden: true

  - name: "🌐 BP·极速"
    type: fallback
    use:
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)1000M|神速|快"
    url: {{ speed_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true

  - name: "⚡ YF·极速"
    type: fallback
    use:
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)专线"
    url: {{ speed_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true

  # --------------------------------------------------------
  # AI 地域闭环容灾 (家宽 > 原生自建 > 机场，严禁跨区)
  # --------------------------------------------------------
{% for ai_spec in [
  {'name': '🇺🇸 美国 · AI', 'proxies': ['🖥️ CC15 · AI', '🖥️ QQG1299 · AI', '🇺🇸 机场 · AI']},
  {'name': '🇯🇵 日本 · AI', 'proxies': ['🇯🇵 [NAT] HK96-优化-Vless-家宽-JP', '🇯🇵 [NAT] JP3-千兆-Vless-原生-JP', '🇯🇵 [VPS] QQG1299-千兆-Vless-原生-JP', '🇯🇵 家宽 · AI', '🇯🇵 日本原生', '🇯🇵 机场 · AI']},
  {'name': '🇸🇬 新加坡 · AI', 'proxies': ['🇸🇬 [NAT] HK96-优化-Vless-家宽-SG', '🇸🇬 家宽 · AI', '🇸🇬 机场 · AI']},
  {'name': '🇹🇼 台湾 · AI', 'proxies': ['🇹🇼 [NAT] HK96-优化-Vless-家宽-TW', '🇹🇼 家宽 · AI', '🇹🇼 机场 · AI']}
] %}
  - name: "{{ ai_spec.name }}"
    type: fallback
    proxies:
{% for p in ai_spec.proxies %}
      - "{{ p }}"
{% endfor %}
    url: {{ ai_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true
{% endfor %}

  # --------------------------------------------------------
  # 金融地域闭环隔离 (仅限纯净家宽与独享 VPS，排除公共机场)
  # --------------------------------------------------------
  - name: "🇹🇼 台湾 · 金融"
    type: fallback
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)(\\[TW\\]|台湾).*(家宽|resi|HiNet)"
    hidden: true

  - name: "🇭🇰 香港 · 金融"
    type: fallback
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)\\[HK\\]|nat-hk"
    hidden: true
  - name: "🇺🇸 美国 · 金融"
    type: fallback
    use:
{% for pid in vps_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)(\\[US\\]|美国).*(原生|家宽)"
    hidden: true
  - name: "🇯🇵 日本 · 金融"
    type: fallback
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)(\\[JP\\]|日本).*(家宽|resi|Sony|原生)"
    hidden: true

  - name: "🇸🇬 新加坡 · 金融"
    type: fallback
    use:
{% for pid in nat_providers.items + vps_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)(\\[SG\\]|新加坡).*(家宽|resi|原生|独享|固定)"
    hidden: true
  - name: "🌐 紧急专线逃生通道"
    type: fallback
    use:
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)专线|IEPL|IPLC"
    url: {{ speed_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true

  # --------------------------------------------------------
  # 中间层特征能力组 (家宽 / 原生 / 机场分类提取)
  # --------------------------------------------------------
{% for r in [
  {'code': 'JP', 'flag': '🇯🇵', 'name': '日本', 'brand': 'Sony'},
  {'code': 'TW', 'flag': '🇹🇼', 'name': '台湾', 'brand': 'HiNet'},
  {'code': 'SG', 'flag': '🇸🇬', 'name': '新加坡', 'brand': 'SG'}
] %}
  - name: "{{ r.flag }} 家宽 · AI"
    type: fallback
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)(\\[{{ r.code }}\\]|{{ r.name }}|{{ r.brand }}).*(家宽|resi)"
    hidden: true
{% endfor %}

{% for r in [
  {'code': 'US', 'flag': '🇺🇸', 'name': '美国'},
  {'code': 'JP', 'flag': '🇯🇵', 'name': '日本'},
  {'code': 'SG', 'flag': '🇸🇬', 'name': '新加坡'},
  {'code': 'TW', 'flag': '🇹🇼', 'name': '台湾'}
] %}
  - name: "{{ r.flag }} 机场 · AI"
    type: fallback
    use:
{% for pid in airport_providers.items + bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)(\\[{{ r.code }}\\]|{{ r.name }}).*{{ tag_ai }}"
    url: {{ ai_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true
{% endfor %}

  - name: "🇯🇵 日本原生"
    type: fallback
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)jp3|原生|1\\.8G|🇯🇵"
    url: {{ speed_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true

  - name: "🇺🇸 洛杉矶独享"
    type: fallback
    use:
{% for pid in vps_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)洛杉矶|US|美国|CC|QQG"
    url: {{ speed_test_url }}
    interval: {{ check_interval }}
    timeout: {{ check_timeout }}
    lazy: true
    hidden: true

  # --------------------------------------------------------
  # 特种低价区与静默解锁
  # --------------------------------------------------------
{% for sp in [
  {'code': 'TR', 'flag': '🇹🇷', 'name': '土耳其'},
  {'code': 'NG', 'flag': '🇳🇬', 'name': '尼日利亚'},
  {'code': 'AR', 'flag': '🇦🇷', 'name': '阿根廷'},
  {'code': 'IN', 'flag': '🇮🇳', 'name': '印度'},
  {'code': 'PK', 'flag': '🇵🇰', 'name': '巴基斯坦'},
  {'code': 'RU', 'flag': '🇷🇺', 'name': '俄罗斯'}
] %}
  - name: "{{ sp.flag }} {{ sp.name }}"
    type: select
    use:
{% for pid in airport_providers.items + bp_providers.items + sk_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i){{ sp.name }}|{{ sp.code }}|{{ sp.flag }}"
    hidden: true
{% endfor %}

  - name: "🇭🇰 港澳"
    type: url-test
    use:
{% for pid in bp_providers.items + airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)🇭🇰|港|hk|hong\\s*kong|🇹🇼|台|tw|taiwan"
    url: {{ speed_test_url }}
    interval: 300
    tolerance: 50
    lazy: true
    hidden: true
  # 兼容私有规则中的 ⚡ 快速节点 引用
  - name: "⚡ 快速节点"
    type: select
    proxies:
      - "⚡ 千兆极速"
      - "🖥️ VPS"
      - DIRECT
    hidden: true

{% for pid in vps_providers.items %}
  - name: "🖥️ {{ pid | upper }} · AI"
    type: fallback
    use:
      - source-{{ pid }}
{% if 'qqg' in pid | lower %}
    filter: "(?i)smart-ai|hy2"
{% endif %}
    url: {{ speed_test_url }}
    interval: 300
    timeout: 5000
    lazy: true
    hidden: true
{% endfor %}

{% include 'sub_store_capability_profile/rule_providers.yaml.j2' %}

{% include 'sub_store_capability_profile/routing_dns.yaml.j2' %}
