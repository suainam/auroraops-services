# Mihomo profile backed by Sub-Store sources with data-driven keyword grouping (#29, #46, #47).

mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: false
enable-process: true
find-process-mode: always

profile:
  store-selected: true

geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb"
  asn: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/GeoLite2-ASN.mmdb"

proxies: []
{% set capability_providers = docker_apps_sub_store_capability_providers %}
{% include 'sub_store_capability_profile/proxy_providers.yaml.j2' %}
{% set vps_providers     = namespace(items=[]) %}
{% set nat_providers     = namespace(items=[]) %}
{% set bp_providers      = namespace(items=[]) %}
{% set sk_providers      = namespace(items=[]) %}
{% set airport_providers = namespace(items=[]) %}
{% for p in capability_providers %}
{% if p.enabled | default(true) %}
{% set pid = p['provider-id'] | default(p.name) %}
{% set dg = p['display-group'] | default('') %}
{% if not dg %}
  {% if 'nat' in p.name | lower %}
    {% set dg = 'NAT' %}
  {% elif 'bp' in p.name | lower or 'baipiao' in p.name | lower %}
    {% set dg = 'BP' %}
  {% elif 'sk' in p.name | lower or 'sakura' in p.name | lower %}
    {% set dg = 'SK' %}
  {% elif 'cc15' in p.name | lower or 'qqg1299' in p.name | lower or 'vps' in p.name | lower or p.owned | default(false) %}
    {% set dg = 'VPS' %}
  {% else %}
    {% set dg = 'AIRPORT' %}
  {% endif %}
{% endif %}
{% if dg == 'VPS' %}
{% set vps_providers.items = vps_providers.items + [pid] %}
{% elif dg == 'NAT' %}
{% set nat_providers.items = nat_providers.items + [pid] %}
{% elif dg == 'BP' %}
{% set bp_providers.items = bp_providers.items + [pid] %}
{% elif dg == 'SK' %}
{% set sk_providers.items = sk_providers.items + [pid] %}
{% elif dg == 'AIRPORT' %}
{% set airport_providers.items = airport_providers.items + [pid] %}
{% endif %}
{% endif %}
{% endfor %}

proxy-groups:
  # ========================================================
  # 1. 顶层业务入口 (Top-Level Services, 常用排在最前面)
  # ========================================================
  # 1. 默认代理 (三网自适应 Fallback 模式，含 DIRECT 与场景手选)
  - name: "🚀 默认代理"
    type: fallback
    proxies:
      - "🇸🇬 新加坡三网"
      - "🇯🇵 日本专线"
      - "🇺🇸 洛杉矶独享"
      - "🏠 联通场景"
      - "🏢 电信场景"
      - "🖥️ VPS"
      - "🧭 NAT"
      - "⚡ 机场"
      - "🌐 BP"
      - "🌸 SK"
      - DIRECT
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    max-failed-times: 3
    lazy: true

  # 2. AI 服务 (长连接防漂移，严禁包含 DIRECT)
  - name: "🤖 AI 服务"
    type: fallback
    proxies:
      - "🇺🇸 洛杉矶独享"
      - "🇯🇵 日本原生"
      - "🏡 真实家宽"
      - "🤖 机场 AI"
      - "🛡️ AI 容灾"
    url: https://chatgpt.com/cdn-cgi/trace
    interval: 180
    timeout: 4000
    lazy: true

  # 3. 金融与交易所 (纯手动 select，严格物理隔离公共机场与直连，自建双保险)
  - name: "🏦 金融与交易所"
    type: select
    proxies:
      - "🏡 真实家宽"
      - "🇺🇸 洛杉矶独享"
      - "🌐 专线逃生通道"

  # 4. Apple 低价区 (纯手动 select，动态过滤土耳其/尼日利亚/阿根廷专线，免开全局)
  - name: "🍎 Apple 低价区"
    type: select
    proxies:
      - DIRECT
      - "🇹🇷 土耳其"
      - "🇳🇬 尼日利亚"
      - "🇦🇷 阿根廷"
      - "🇺🇸 洛杉矶独享"

  # 5. 千兆极速 (合并视频开发与 Telegram：BP 1T -> YF 1T -> 自建大水管)
  - name: "⚡ 千兆极速"
    type: fallback
    proxies:
      - "🌐 BP 极速"
      - "⚡ YF 专线"
      - "🇯🇵 日本原生"
      - "🇺🇸 洛杉矶独享"
      - "⚡ 千兆优选"
      - DIRECT
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    lazy: true

  - name: "📺 B站港澳"
    type: select
    proxies:
      - "香港优选"
      - "🧭 NAT · 港澳"
      - "🌐 BP · 港澳"
      - "🌸 SK · 港澳"
      - DIRECT

  # ========================================================
  # 2. 场景与运营商快速手选组
  # ========================================================
  - name: "🏠 联通场景"
    type: select
    proxies:
      - "🇯🇵 日本专线"
      - "🇺🇸 洛杉矶独享"
      - "⚡ 机场"
      - DIRECT

  - name: "🏢 电信场景"
    type: select
    proxies:
      - "🇸🇬 新加坡三网"
      - "🇺🇸 洛杉矶独享"
      - "⚡ 机场"
      - DIRECT

  - name: "💰 低倍率走廊"
    type: select
    use:
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)0\\.1|0\\.01|低倍"
  # ========================================================
  # 2. 底层节点实体池 (Entity Pools, 纯手动查看与单选)
  # ========================================================
  - name: "🖥️ VPS"
    type: select
    use:
{% for pid in vps_providers.items %}
      - source-{{ pid }}
{% endfor %}

  - name: "🧭 NAT"
    type: select
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}

  - name: "⚡ 机场"
    type: select
    use:
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}

  - name: "🌐 BP"
    type: select
    use:
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}

  - name: "🌸 SK"
    type: select
    use:
{% for pid in sk_providers.items %}
      - source-{{ pid }}
{% endfor %}

  # ========================================================
  # 3. 内部定向与能力子组 (hidden: true)
  # ========================================================
  - name: "🇸🇬 新加坡三网"
    type: fallback
    use:
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)🇸🇬|新加坡|SG"
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    lazy: true
    hidden: true

  - name: "🇯🇵 日本专线"
    type: fallback
    use:
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)🇯🇵|日本|JP|AWS日本"
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    lazy: true
    hidden: true

  - name: "🇺🇸 洛杉矶独享"
    type: fallback
    use:
{% for pid in vps_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)洛杉矶|US|美国|CC|QQG"
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    lazy: true
    hidden: true

  - name: "🇯🇵 日本原生"
    type: fallback
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)jp3|原生|1\\.8G|🇯🇵"
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    lazy: true
    hidden: true

  - name: "🏡 真实家宽"
    type: select
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)家宽|resi|Residential"
    hidden: true

  - name: "🤖 机场 AI"
    type: fallback
    use:
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)(?:^|[^a-z])ai(?:[^a-z]|$)|chatgpt|gpt|claude|gemini|解锁"
    url: https://chatgpt.com/cdn-cgi/trace
    interval: 180
    timeout: 4000
    lazy: true
    hidden: true

  - name: "🌐 专线逃生通道"
    type: fallback
    use:
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)专线|IEPL|IPLC"
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    lazy: true
    hidden: true

  - name: "⚡ 千兆优选"
    type: fallback
    proxies:
      - "🌐 BP 极速"
      - "⚡ YF 专线"
      - "🇯🇵 日本原生"
      - "🇺🇸 洛杉矶独享"
    url: https://www.gstatic.com/generate_204
    interval: 300
    lazy: true
    hidden: true

  - name: "🛡️ AI 容灾"
    type: fallback
    proxies:
{% for pid in vps_providers.items %}
      - "🖥️ {{ pid | upper }} · AI"
{% endfor %}
      - "🧭 NAT · AI"
      - "🌐 BP · AI"
    url: https://chatgpt.com/cdn-cgi/trace
    interval: 300
    timeout: 2500
    lazy: true
    hidden: true
  - name: "🇹🇷 土耳其"
    type: select
    use:
{% for pid in sk_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)土耳其|TR|🇹🇷"
    hidden: true

  - name: "🇳🇬 尼日利亚"
    type: select
    use:
{% for pid in sk_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)尼日利亚|NG|🇳🇬"
    hidden: true

  - name: "🇦🇷 阿根廷"
    type: select
    use:
{% for pid in sk_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)阿根廷|AR|🇦🇷"
    hidden: true

  - name: "🌐 BP 极速"
    type: fallback
    use:
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)1000M|神速|快"
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    lazy: true
    hidden: true

  - name: "⚡ YF 专线"
    type: fallback
    use:
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)专线"
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    lazy: true
    hidden: true

  # ========================================================
  # 3. 内部策略与定向子组 (全部 hidden: true, 前端隐形)
  # ========================================================
  # 香港最低延迟竞速优选组，专门为 📺 B站港澳 默认调用
  - name: "香港优选"
    type: url-test
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)🇭🇰|港|hk|hong\\s*kong"
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    lazy: true
    hidden: true


{% for pid in vps_providers.items %}
  - name: "🖥️ {{ pid | upper }} · AI"
    type: fallback
    use:
      - source-{{ pid }}
{% if 'qqg' in pid | lower %}
    # 严格门禁：qqg1299 仅允许 smart-ai 专用出口进入 AI 容灾，排除机房原生节点（避免送中漂移）
    filter: "(?i)smart-ai"
{% endif %}
    url: https://www.gstatic.com/generate_204
    interval: 300
    timeout: 5000
    lazy: true
    hidden: true
{% endfor %}

  - name: "🧭 NAT · AI"
    type: fallback
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}
    # 严格限定具备 AI 出口能力的节点（如 nat-jp3），彻底过滤香港节点（OpenAI 403 阻断）(#110)
    filter: "(?i)🇯🇵|jp|japan|smart-ai"
    url: https://www.gstatic.com/generate_204
    interval: 300
    timeout: 5000
    lazy: true
    hidden: true
  # 精准匹配真正的 AI 关键词，彻底排除 [baipiao] 自身拼音误命中
  - name: "🌐 BP · AI"
    type: fallback
    use:
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)Gemini|ChatGPT|GPT|直连AI|[-_\\s]AI|AI[-_\\s$]"
    url: https://www.gstatic.com/generate_204
    interval: 300
    timeout: 5000
    lazy: true
    hidden: true

  # 港澳定向子组
  - name: "🧭 NAT · 港澳"
    type: fallback
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)🇭🇰|港|hk|hong\\s*kong|🇹🇼|台|tw|taiwan"
    url: https://www.gstatic.com/generate_204
    interval: 300
    lazy: true
    hidden: true

  - name: "🌐 BP · 港澳"
    type: fallback
    use:
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)🇭🇰|香港|🇹🇼|台湾|HK|TW"
    url: https://www.gstatic.com/generate_204
    interval: 300
    lazy: true
    hidden: true

  - name: "🌸 SK · 港澳"
    type: select
    use:
{% for pid in sk_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)🇭🇰|香港|🇹🇼|台湾|HK|TW"
    hidden: true

  # 兼容私有规则中的 ⚡ 快速节点 引用
  - name: "⚡ 快速节点"
    type: select
    proxies:
      - "⚡ 千兆优选"
      - "🖥️ VPS"
      - DIRECT
    hidden: true

{% include 'sub_store_capability_profile/rule_providers.yaml.j2' %}

{% include 'sub_store_capability_profile/routing_dns.yaml.j2' %}
