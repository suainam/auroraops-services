{% for pid in sk_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)土耳其|TR|🇹🇷"
    hidden: true

  - name: "🇳🇬 尼日利亚"
    type: select
    use:
{% for pid in sk_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)尼日利亚|NG|🇳🇬"
    hidden: true

  - name: "🇦🇷 阿根廷"
    type: select
    use:
{% for pid in sk_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)阿根廷|AR|🇦🇷"
    hidden: true

  - name: "🇭🇰 港澳"
    type: url-test
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)🇭🇰|港|hk|hong\\s*kong|🇹🇼|台|tw|taiwan"
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    lazy: true
    hidden: true

  # 兼容私有规则中的 ⚡ 快速节点 引用
  - name: "⚡ 快速节点"
    type: select
    proxies:
      - "⚡ 千兆极速"
      - "🖥️ VPS"
      - DIRECT
    hidden: true

{% for pid in vps_providers.items %}
  - name: "🖥️ {{ pid | upper }} · AI"
    type: fallback
    use:
      - source-{{ pid }}
{% if 'qqg' in pid | lower %}
    filter: "(?i)smart-ai|hy2"
{% endif %}
    url: https://www.gstatic.com/generate_204
    interval: 300
    timeout: 5000
    lazy: true
    hidden: true
{% endfor %}

