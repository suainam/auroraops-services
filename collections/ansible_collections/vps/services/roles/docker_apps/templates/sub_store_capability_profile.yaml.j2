# Mihomo profile backed by Sub-Store sources with data-driven keyword grouping (#29, #46, #47).

mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: false
enable-process: true
find-process-mode: always

profile:
  store-selected: true

geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb"
  asn: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/GeoLite2-ASN.mmdb"

proxies: []
{% set capability_providers = docker_apps_sub_store_capability_providers %}
{% include 'sub_store_capability_profile/proxy_providers.yaml.j2' %}
{% set vps_providers     = namespace(items=[]) %}
{% set nat_providers     = namespace(items=[]) %}
{% set bp_providers      = namespace(items=[]) %}
{% set sk_providers      = namespace(items=[]) %}
{% set airport_providers = namespace(items=[]) %}
{% for p in capability_providers %}
{% if p.enabled | default(true) %}
{% set pid = p['provider-id'] | default(p.name) %}
{% set dg = p['display-group'] | default('') %}
{% if not dg %}
  {% if 'nat' in p.name | lower %}
    {% set dg = 'NAT' %}
  {% elif 'bp' in p.name | lower or 'baipiao' in p.name | lower %}
    {% set dg = 'BP' %}
  {% elif 'sk' in p.name | lower or 'sakura' in p.name | lower %}
    {% set dg = 'SK' %}
  {% elif 'cc15' in p.name | lower or 'qqg1299' in p.name | lower or 'vps' in p.name | lower or p.owned | default(false) %}
    {% set dg = 'VPS' %}
  {% else %}
    {% set dg = 'AIRPORT' %}
  {% endif %}
{% endif %}
{% if dg == 'VPS' %}
{% set vps_providers.items = vps_providers.items + [pid] %}
{% elif dg == 'NAT' %}
{% set nat_providers.items = nat_providers.items + [pid] %}
{% elif dg == 'BP' %}
{% set bp_providers.items = bp_providers.items + [pid] %}
{% elif dg == 'SK' %}
{% set sk_providers.items = sk_providers.items + [pid] %}
{% elif dg == 'AIRPORT' %}
{% set airport_providers.items = airport_providers.items + [pid] %}
{% endif %}
{% endif %}
{% endfor %}

proxy-groups:
  # ========================================================
  # 1. 顶层业务入口 (Top-Level Services, 客户端仅暴露这 5 个)
  # ========================================================
  # 1. 默认代理 (极简 3 大场景)
  - name: "🚀 默认代理"
    type: select
    proxies:
      - "⚡ 千兆极速"
      - "💰 低倍率走廊"
      - DIRECT

  # 2. 千兆极速 (合并视频开发与 Telegram，形式化统一港台日新美五大区)
  - name: "⚡ 千兆极速"
    type: select
    proxies:
      - "⚡ 自动优选"
      - "🇭🇰 香港 · 极速"
      - "🇹🇼 台湾 · 极速"
      - "🇯🇵 日本 · 极速"
      - "🇸🇬 新加坡 · 极速"
      - "🇺🇸 美国 · 极速"
      - DIRECT

  # 3. AI 服务 (地域绝对闭环手选，严禁包含 DIRECT)
  - name: "🤖 AI 服务"
    type: select
    proxies:
      - "🇺🇸 美国 · AI"
      - "🇯🇵 日本 · AI"
      - "🇸🇬 新加坡 · AI"
      - "🇹🇼 台湾 · AI"

  # 4. 金融与交易所 (纯手动 select，严格物理隔离公共机场，自建双保险，严禁 DIRECT)
  - name: "🏦 金融与交易所"
    type: select
    proxies:
      - "🇹🇼 台湾 · 金融"
      - "🇭🇰 香港 · 金融"
      - "🇺🇸 美国 · 金融"
      - "🇯🇵 日本 · 金融"
      - "🇸🇬 新加坡 · 金融"
      - "🌐 紧急专线逃生通道"

  # 5. Apple 低价区 (纯手动 select，免开全局注册/充值)
  - name: "🍎 Apple 低价区"
    type: select
    proxies:
      - DIRECT
      - "🇹🇷 土耳其"
      - "🇳🇬 尼日利亚"
      - "🇦🇷 阿根廷"
      - "🌸 SK"

  # ========================================================
  # 2. 底层节点实体池 (Entity Pools, 纯手动查看与单选)
  # ========================================================
  - name: "🖥️ VPS"
    type: select
    use:
{% for pid in vps_providers.items %}
      - source-{{ pid }}
{% endfor %}

  - name: "🧭 NAT"
    type: select
    use:
{% for pid in nat_providers.items %}
      - source-{{ pid }}
{% endfor %}

  - name: "⚡ YF"
    type: select
    proxies:
      - "⚡ YF·自动优选"
    use:
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}

  - name: "🌐 BP"
    type: select
    proxies:
      - "🌐 BP·自动优选"
    use:
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}

  - name: "🌸 SK"
    type: select
    use:
{% for pid in sk_providers.items %}
      - source-{{ pid }}
{% endfor %}

  # ========================================================
  # 3. 内部定向与能力子组 (全部 hidden: true, 前端隐形)
  # ========================================================
  # 💰 低倍率走廊
  - name: "💰 低倍率走廊"
    type: select
    use:
{% for pid in airport_providers.items %}
      - source-{{ pid }}
{% endfor %}
{% for pid in bp_providers.items %}
      - source-{{ pid }}
{% endfor %}
    filter: "(?i)0\\.1|0\\.01|低倍"
    hidden: true

  # --------------------------------------------------------
  # 极速地域五大区 (自动优选 + 港台日新美，专线 > 大带宽 > 自建)
  # --------------------------------------------------------
  - name: "⚡ 自动优选"
    type: fallback
    proxies:
      - "🇭🇰 香港 · 极速"
      - "🇹🇼 台湾 · 极速"
      - "🇯🇵 日本 · 极速"
      - "🇸🇬 新加坡 · 极速"
      - "🇺🇸 美国 · 极速"
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    lazy: true
    hidden: true
  # ⚡ 国际流媒体 (专为 YouTube / Disney+ / Netflix 打造的高速通道，严格排除香港，防 403 与无会员)
  - name: "⚡ 国际流媒体"
    type: fallback
    proxies:
      - "🇸🇬 新加坡 · 极速"
      - "🇯🇵 日本 · 极速"
      - "🇺🇸 美国 · 极速"
      - "🇹🇼 台湾 · 极速"
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    lazy: true
    hidden: true

  - name: "🇭🇰 香港 · 极速"
    type: fallback
    proxies:
      - "🇭🇰 专线 · 极速"
      - "🇭🇰 大带宽 · 极速"
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    lazy: true
    hidden: true

  - name: "🇹🇼 台湾 · 极速"
    type: fallback
    proxies:
      - "🇹🇼 专线 · 极速"
      - "🇹🇼 大带宽 · 极速"
    url: https://www.gstatic.com/generate_204
    interval: 180
    timeout: 4000
    lazy: true
    hidden: true

  - name: "🇯🇵 日本 · 极速"
    type: fallback
    proxies:
      - "🇯🇵 专线 · 极速"
      - "🇯🇵 大带宽 · 极速"
