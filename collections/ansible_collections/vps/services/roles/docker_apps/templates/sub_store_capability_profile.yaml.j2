# Mihomo capability profile - Pure Tag-Driven & Ultra-Compressed (#166)
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: false
enable-process: true
find-process-mode: always
profile:
  store-selected: true

geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb"
  asn: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/GeoLite2-ASN.mmdb"

proxies: []
{% set capability_providers = docker_apps_sub_store_capability_providers | default([]) %}
{% include 'sub_store_capability_profile/proxy_providers.yaml.j2' %}
{% set vps_src = namespace(items=[]) %}
{% set nat_src = namespace(items=[]) %}
{% set general_airport_src = namespace(items=[]) %}
{% set all_airport_src = namespace(items=[]) %}
{% for p in capability_providers if p.enabled | default(true) %}
  {% set s = 'source-' ~ (p['provider-id'] | default(p.name)) %}
  {% set dg = (p['display-group'] | default('AIRPORT')) | upper %}
  {% if dg == 'VPS' %}{% set vps_src.items = vps_src.items + [s] %}
  {% elif dg == 'NAT' %}{% set nat_src.items = nat_src.items + [s] %}
  {% elif dg == 'SK' %}{% set all_airport_src.items = all_airport_src.items + [s] %}
  {% else %}
    {% set general_airport_src.items = general_airport_src.items + [s] %}
    {% set all_airport_src.items = all_airport_src.items + [s] %}
  {% endif %}
{% endfor %}
{% set test_url = 'https://www.gstatic.com/generate_204' %}
{% set ai_url   = 'https://www.cloudflare.com/cdn-cgi/trace' %}
{% set regions = [{'c': 'HK', 'f': '🇭🇰'}, {'c': 'TW', 'f': '🇹🇼'}, {'c': 'JP', 'f': '🇯🇵'}, {'c': 'SG', 'f': '🇸🇬'}, {'c': 'US', 'f': '🇺🇸'}] %}

proxy-groups:
  - name: "🚀 默认代理"
    type: select
    proxies: ["⚡ 千兆极速", "💰 低倍率走廊", DIRECT]
  - name: "⚡ 千兆极速"
    type: select
    proxies: ["⚡ 自动优选", "🇭🇰 HK · 极速", "🇹🇼 TW · 极速", "🇯🇵 JP · 极速", "🇸🇬 SG · 极速", "🇺🇸 US · 极速", DIRECT]
  - name: "🤖 AI 服务"
    type: select
    proxies: ["🇺🇸 US · AI", "🇯🇵 JP · AI", "🇸🇬 SG · AI", "🇹🇼 TW · AI"]
  - name: "🏦 金融与交易所"
    type: select
    proxies: ["🇹🇼 TW · 金融", "🇭🇰 HK · 金融", "🇺🇸 US · 金融", "🇯🇵 JP · 金融", "🇸🇬 SG · 金融", "🌐 紧急专线逃生通道"]
  - name: "🍎 Apple 低价区"
    type: select
    proxies: ["DIRECT", "🇹🇷 TR", "🇳🇬 NG", "🇦🇷 AR", "🇮🇳 IN", "🇷🇺 RU", "🇯🇵 JP · 极速", "🌸 SK"]

  # 5 大实体池
  - name: "🖥️ VPS"
    type: select
    use: {{ vps_src.items | to_json }}
    filter: "(?i)\\[VPS\\]"
  - name: "🧭 NAT"
    type: select
    use: {{ nat_src.items | to_json }}
    filter: "(?i)\\[NAT\\]"
  - name: "⚡ YF"
    type: select
    use: {{ general_airport_src.items | to_json }}
    filter: "(?i)\\[YF\\]"
  - name: "🌐 BP"
    type: select
    use: {{ general_airport_src.items | to_json }}
    filter: "(?i)\\[BP\\]"
  - name: "🌸 SK"
    type: select
    use: {{ all_airport_src.items | to_json }}
    filter: "(?i)\\[SK\\](?!.*(?:剩余流量|套餐到期))"

  - name: "💰 低倍率走廊"
    type: select
    use: {{ general_airport_src.items | to_json }}
    filter: "(?i)0\\.1|0\\.01|低倍"
    hidden: true
  - name: "⚡ 自动优选"
    type: fallback
    proxies: ["🇯🇵 JP · 极速", "🇺🇸 US · 极速", "🇸🇬 SG · 极速", "🇭🇰 HK · 极速", "🇹🇼 TW · 极速"]
    url: {{ test_url }}
    interval: 180
    lazy: true
    hidden: true
  - name: "⚡ 国际流媒体"
    type: fallback
    proxies: ["🇯🇵 JP · 极速", "🇺🇸 US · 极速", "🇸🇬 SG · 极速", "🇹🇼 TW · 极速", "🌐 紧急专线逃生通道"]
    url: {{ test_url }}
    interval: 180
    lazy: true
    hidden: true
{% for r in regions %}
  - name: "{{ r.f }} {{ r.c }} · 极速"
    type: fallback
    proxies: ["{{ r.f }} {{ r.c }} · 专线", "{{ r.f }} {{ r.c }} · 千兆", "{{ r.f }} {{ r.c }} · 普通"]
    url: {{ test_url }}
    interval: 180
    lazy: true
    hidden: true
  - name: "{{ r.f }} {{ r.c }} · 专线"
    type: fallback
    use: {{ general_airport_src.items | to_json }}
    filter: "(?i)(\\[{{ r.c }}\\]|\\b{{ r.c }}\\b|{{ r.f }}).*专线"
    url: {{ test_url }}
    interval: 180
    lazy: true
    hidden: true
  - name: "{{ r.f }} {{ r.c }} · 千兆"
    type: fallback
    use: {{ (vps_src.items + nat_src.items + general_airport_src.items) | to_json }}
    filter: "(?i)(\\[{{ r.c }}\\]|\\b{{ r.c }}\\b|{{ r.f }}).*千兆"
    url: {{ test_url }}
    interval: 180
    lazy: true
    hidden: true
  - name: "{{ r.f }} {{ r.c }} · 普通"
    type: fallback
    use: {{ general_airport_src.items | to_json }}
    filter: "(?i)(\\[{{ r.c }}\\]|\\b{{ r.c }}\\b|{{ r.f }})"
    url: {{ test_url }}
    interval: 180
    lazy: true
    hidden: true
{% endfor %}
{% for r in regions if r.c != 'HK' %}
  - name: "{{ r.f }} {{ r.c }} · AI"
    type: fallback
    proxies: ["{{ r.f }} {{ r.c }} · 自建AI", "{{ r.f }} {{ r.c }} · 机场AI"]
    url: {{ ai_url }}
    interval: 180
    timeout: 5000
    lazy: true
    hidden: true
  - name: "{{ r.f }} {{ r.c }} · 自建AI"
    type: fallback
    use: {{ (vps_src.items + nat_src.items) | to_json }}
    filter: "(?i)(?!.*送中)(\\[{{ r.c }}\\]|\\b{{ r.c }}\\b|{{ r.f }}).*(家宽|原生|静态|中继)"
    url: {{ ai_url }}
    interval: 180
    timeout: 5000
    lazy: true
    hidden: true
  - name: "{{ r.f }} {{ r.c }} · 机场AI"
    type: fallback
    use: {{ general_airport_src.items | to_json }}
    filter: "(?i)(?!.*送中)(\\[{{ r.c }}\\]|\\b{{ r.c }}\\b|{{ r.f }}).*AI"
    url: {{ ai_url }}
    interval: 180
    timeout: 5000
    lazy: true
    hidden: true
{% endfor %}
{% for r in regions %}
  - name: "{{ r.f }} {{ r.c }} · 金融"
    type: fallback
    use: {{ (vps_src.items + nat_src.items) | to_json }}
    filter: "(?i)(?!.*送中)(\\[{{ r.c }}\\]|\\b{{ r.c }}\\b|{{ r.f }}).*(家宽|原生|静态)"
    hidden: true
{% endfor %}
  - name: "🌐 紧急专线逃生通道"
    type: fallback
    use: {{ general_airport_src.items | to_json }}
    filter: "(?i)专线|IEPL|IPLC"
    url: {{ test_url }}
    interval: 180
    lazy: true
    hidden: true

  # Apple 特种低价区 (纯中文地名+专属Emoji匹配，负向断言防 Gemini/Trojan 误伤)
{% for c, f, kw in [
  ('TR','🇹🇷','土耳其|🇹🇷'),
  ('NG','🇳🇬','尼日利亚|🇳🇬'),
  ('AR','🇦🇷','阿根廷|🇦🇷'),
  ('IN','🇮🇳','(?<![a-zA-Z])印度(?!尼西亚)|🇮🇳'),
  ('RU','🇷🇺','俄罗斯|莫斯科|🇷🇺')
] %}
  - name: "{{ f }} {{ c }}"
    type: select
    use: {{ all_airport_src.items | to_json }}
    filter: "(?i){{ kw }}"
    hidden: true
{% endfor %}
  - name: "🇭🇰 港澳"
    type: url-test
    use: {{ general_airport_src.items | to_json }}
    filter: "(?i)(\\[(HK|TW)\\]|\\b(HK|TW)\\b|🇭🇰|🇹🇼)"
    url: {{ test_url }}
    interval: 300
    lazy: true
    hidden: true
  - name: "⚡ 快速节点"
    type: select
    proxies: ["⚡ 千兆极速", "🖥️ VPS", DIRECT]
    hidden: true

{% include 'sub_store_capability_profile/rules.yaml.j2' %}
{% include 'sub_store_capability_profile/dns.yaml.j2' %}
