{% set catalog = lookup('file', role_path ~ '/files/cliproxyapi_antigravity_models.json') | from_json %}
{% for model in catalog.models | sort(attribute='name') %}
{% if model.upstream_name != model.name %}
    - name: "{{ model.upstream_name }}"
      alias: "{{ model.name }}"
{% if model.name == 'gemini-3.1-pro-preview' %}
      display-name: "Antigravity Gemini 3.1 Pro"
      fork: true
      force-mapping: true
{% endif %}
{% endif %}
{% endfor %}
