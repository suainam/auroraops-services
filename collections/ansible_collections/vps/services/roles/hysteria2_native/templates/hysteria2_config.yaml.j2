# Hysteria2 Client Configuration (Generated by AuroraOps vps.services.hysteria2_native)
# Documentation: https://v2.hysteria.network/docs/getting-started/Client/

server: "{{ hysteria2_native_server }}:{{ hysteria2_native_server_port }}"
auth: "{{ hysteria2_native_auth_password }}"

tls:
  sni: "{{ hysteria2_native_sni }}"
  insecure: {{ hysteria2_native_insecure | lower }}
{% if hysteria2_native_alpn is defined and hysteria2_native_alpn | length > 0 %}
  alpn:
{% for alpn_proto in hysteria2_native_alpn %}
    - "{{ alpn_proto }}"
{% endfor %}
{% endif %}

{% if hysteria2_native_obfs_type is defined and hysteria2_native_obfs_type | length > 0 %}
obfs:
  type: {{ hysteria2_native_obfs_type }}
  {{ hysteria2_native_obfs_type }}:
    password: "{{ hysteria2_native_obfs_password }}"
{% endif %}

{% if (hysteria2_native_bandwidth_up | default('') | length > 0) or (hysteria2_native_bandwidth_down | default('') | length > 0) %}
bandwidth:
{% if hysteria2_native_bandwidth_up | default('') | length > 0 %}
  up: {{ hysteria2_native_bandwidth_up }}
{% endif %}
{% if hysteria2_native_bandwidth_down | default('') | length > 0 %}
  down: {{ hysteria2_native_bandwidth_down }}
{% endif %}
{% endif %}

socks5:
  listen: "{{ hysteria2_native_socks5_host }}:{{ hysteria2_native_socks5_port }}"

http:
  listen: "{{ hysteria2_native_http_host }}:{{ hysteria2_native_http_port }}"
